# Variables de entorno del backend (todas opcionales). En Windows se definen en iniciar.bat
# con "set NOMBRE=valor" o en PowerShell con $env:NOMBRE="valor". Este archivo es solo una guía.

# Base SQLite alternativa (por defecto safevison_baken/safevision.db)
LOCAL_DATABASE_URL=
# Carpeta de capturas (por defecto capturas/). Usa otra al probar con una COPIA de la base.
SAFEVISION_CAPTURE_DIR=
# Análisis por segundo y cámara (2 por defecto)
SAFEVISION_MAX_FPS=2
# Minutos sin respuesta antes de avisar al administrador (5 por defecto)
SAFEVISION_ESCALAR_MIN=5
# 1 = fase de prueba (permite borrar incidencias al iniciar). 0 en la versión final.
SAFEVISION_MODO_PRUEBA=1
# Orígenes web extra, separados por comas. La red local ya está permitida.
SAFEVISION_CORS_ORIGINS=
# 0 = no aceptar automáticamente los orígenes de la red local
SAFEVISION_CORS_LAN=1
# Contraseña del primer administrador para tools/create_admin.py (si no, se pide por teclado)
SAFEVISION_ADMIN_PASSWORD=
